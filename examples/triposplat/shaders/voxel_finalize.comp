#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 3) readonly buffer AccumulationBuffer {
    uint values[];
} accumulation;

layout(std430, binding = 4) writeonly buffer RecordBuffer {
    uvec4 values[];
} records;

layout(std430, binding = 5) buffer CounterBuffer {
    uint value;
} counter;

layout(push_constant) uniform PushConstants {
    uint gaussian_count;
    uint total_pairs;
    uint resolution;
    uint integration_steps;
    float iso;
    float tolerance;
    float color_weight_power;
    float opacity_threshold;
    uint chunk_z_begin;
    uint chunk_z_count;
    uint output_z_begin;
    uint output_z_count;
    uint work_item_base;
    uint reserved;
} pc;

bool occupied(uint index) {
    return uintBitsToFloat(accumulation.values[index * 5]) >=
           pc.opacity_threshold;
}

void main() {
    const uint index =
        pc.work_item_base + gl_GlobalInvocationID.x;
    const uint voxel_count =
        pc.resolution * pc.resolution * pc.chunk_z_count;
    if (index >= voxel_count) {
        return;
    }
    const uint plane = pc.resolution * pc.resolution;
    const uint local_z = index / plane;
    const uint global_z = pc.chunk_z_begin + local_z;
    if (global_z < pc.output_z_begin ||
        global_z >= pc.output_z_begin + pc.output_z_count) {
        return;
    }
    const uint base = index * 5;
    const float alpha = uintBitsToFloat(accumulation.values[base]);
    if (alpha < pc.opacity_threshold) {
        return;
    }
    const uint x = index % pc.resolution;
    const uint y = (index / pc.resolution) % pc.resolution;
    const bool interior =
        x > 0 && occupied(index - 1) &&
        x + 1 < pc.resolution && occupied(index + 1) &&
        y > 0 && occupied(index - pc.resolution) &&
        y + 1 < pc.resolution && occupied(index + pc.resolution) &&
        global_z > 0 && occupied(index - plane) &&
        global_z + 1 < pc.resolution && occupied(index + plane);
    if (interior) {
        return;
    }
    const float weight =
        max(uintBitsToFloat(accumulation.values[base + 1]), 1e-12);
    const vec3 color = clamp(
        vec3(uintBitsToFloat(accumulation.values[base + 2]),
             uintBitsToFloat(accumulation.values[base + 3]),
             uintBitsToFloat(accumulation.values[base + 4])) / weight,
        vec3(0.0), vec3(1.0));
    const uint output_index = atomicAdd(counter.value, 1);
    const uint global_index =
        x + pc.resolution * (y + pc.resolution * global_z);
    records.values[output_index] =
        uvec4(global_index, floatBitsToUint(color.r),
              floatBitsToUint(color.g), floatBitsToUint(color.b));
}
